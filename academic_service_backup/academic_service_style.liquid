{% comment %}
  Academic Service — match the 2-column Education entry layout.
  Only this CV section is targeted. Education, Awards, Lectures, News and
  other CV sections are unchanged. The original section border is retained.
{% endcomment %}
<style>
/* Hide only the generic bullet output, after the custom timeline was inserted. */
.cv > a.anchor#academic-service + .card > .academic-service-timeline ~ div,
.cv > a.anchor#academic-service + .card > .academic-service-timeline ~ ul.list-group {
  display: none !important;
}
.cv > a.anchor#academic-service + .card > .academic-service-timeline {
  display: block !important;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}
.cv .academic-service-timeline,
.cv .academic-service-timeline * { box-sizing: border-box; }

/* Keep the three clearly labeled activity groups, with no inner cards. */
.cv .academic-service-group + .academic-service-group {
  margin-top: 1.1rem;
  padding-top: 1rem;
  border-top: 1px solid color-mix(in srgb, var(--global-text-color, #dce4ec) 16%, transparent);
}
.cv .academic-service-group-title {
  margin: 0 0 .95rem;
  padding: 0;
  color: var(--global-theme-color, #2caccb);
  font-size: .95rem;
  font-weight: 650;
  line-height: 1.4;
}

/* Education / Awards use Bootstrap-compatible .row and .col-sm-{2,10}.
   Supply the same widths within this section even if Bootstrap compat is off. */
.cv .academic-service-entry {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -15px .92rem;
  align-items: flex-start;
  line-height: 1.5;
}
.cv .academic-service-entry:last-child { margin-bottom: 0; }
.cv .academic-service-entry > .academic-service-date,
.cv .academic-service-entry > .academic-service-detail {
  position: relative;
  width: 100%;
  min-width: 0;
  padding: 0 15px;
  background: transparent;
  border: 0;
  box-shadow: none;
}
@media (min-width: 576px) {
  .cv .academic-service-entry > .academic-service-date {
    flex: 0 0 16.66666667%;
    max-width: 16.66666667%;
  }
  .cv .academic-service-entry > .academic-service-detail {
    flex: 0 0 83.33333333%;
    max-width: 83.33333333%;
  }
}
@media (max-width: 575.98px) {
  .cv .academic-service-entry > .academic-service-date,
  .cv .academic-service-entry > .academic-service-detail {
    flex: 0 0 100%;
    max-width: 100%;
  }
  .cv .academic-service-detail { margin-top: .32rem; }
}

/* Use the same .badge and .title/.institution utility classes as Education.
   No custom date badge coloring or location row is introduced here. */
.cv .academic-service-year {
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.cv .academic-service-primary,
.cv .academic-service-secondary {
  min-width: 0;
  overflow-wrap: break-word;
  word-break: normal;
}
.cv .academic-service-conference + .academic-service-conference::before {
  content: "  ·  ";
  white-space: pre;
  font-weight: 400;
  opacity: .65;
}
.cv .academic-service-organizing-role + .academic-service-organizing-role {
  margin-top: .55rem;
}
.cv .academic-service-unknown p { margin: 0; }
</style>
