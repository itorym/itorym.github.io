{% comment %}
  Academic Service — Education-style layout.
  Data source: the existing three bullet items under sections['Academic Service']
  in _data/cv.yml. This does not duplicate or rewrite CV data.

  The row / col-sm-2 / col-sm-10 / badge / title / institution / ml-md-4
  structure intentionally follows al_folio_cv's Education entries.
  Year on the left, content on the right; no location fields or icons.
{% endcomment %}
{% assign academic_service_items = site.data.cv.cv.sections['Academic Service'] %}
<section class="academic-service-timeline" aria-label="Academic Service details">
  {% for entry in academic_service_items %}
    {% assign service_text = entry.bullet | default: '' | remove: '**' | strip %}
    {% assign service_kind = service_text | split: ':' | first | strip %}

    {% if service_kind == 'Editorial Board' %}
      {% assign editorial_text = service_text | remove_first: 'Editorial Board:' | strip %}
      {% assign editorial_parts = editorial_text | split: ', ' %}
      {% assign editorial_title = editorial_parts | first | strip %}
      {% assign editorial_period = editorial_parts | last | strip | replace: '--', '–' %}
      {% assign editorial_range = editorial_period | split: '–' %}
      {% assign editorial_start_year = editorial_range | first | slice: 0, 4 %}
      {% assign editorial_end_year = editorial_range | last | slice: -4, 4 %}
      {% if editorial_range.size == 2 and editorial_start_year.size == 4 and editorial_end_year.size == 4 %}
        {% capture editorial_badge %}{{ editorial_start_year }}–{{ editorial_end_year }}{% endcapture %}
      {% else %}
        {% assign editorial_badge = editorial_period %}
      {% endif %}
      <div class="academic-service-group">
        <h4 class="academic-service-group-title">Editorial Board</h4>
        <div class="row academic-service-entry">
          <div class="col-sm-2 academic-service-date">
            <span class="badge font-weight-bold text-uppercase align-middle academic-service-year" title="{{ editorial_period | escape }}">{{ editorial_badge | strip | escape }}</span>
          </div>
          <div class="col-sm-10 academic-service-detail">
            <div class="title font-weight-bold ml-1 ml-md-4 academic-service-primary">{{ editorial_title | escape }}</div>
            <div class="institution font-weight-light ml-1 ml-md-4 academic-service-secondary">Editorial Board Member</div>
          </div>
        </div>
      </div>

    {% elsif service_kind == 'Program Committee' %}
      {% assign program_text = service_text | remove_first: 'Program Committee:' | strip %}
      {% assign program_conferences = program_text | split: ',' %}
      {% capture program_years_text %}{%- for conference in program_conferences -%}{%- assign conference_name = conference | strip -%}{{- conference_name | slice: -4, 4 -}}|{%- endfor -%}{% endcapture %}
      {% assign program_years = program_years_text | split: '|' | uniq | sort | reverse %}
      <div class="academic-service-group">
        <h4 class="academic-service-group-title">Program Committee</h4>
        {% for year in program_years %}
          {% if year.size == 4 %}
            <div class="row academic-service-entry">
              <div class="col-sm-2 academic-service-date">
                <span class="badge font-weight-bold text-uppercase align-middle academic-service-year">{{ year | escape }}</span>
              </div>
              <div class="col-sm-10 academic-service-detail">
                <div class="title font-weight-bold ml-1 ml-md-4 academic-service-primary academic-service-conferences">
                  {% for conference in program_conferences %}
                    {% assign conference_name = conference | strip %}
                    {% assign conference_year = conference_name | slice: -4, 4 %}
                    {% if conference_year == year %}
                      {% assign short_name = conference_name | remove: conference_year | strip %}
                      <span class="academic-service-conference" title="{{ conference_name | escape }}">{{ short_name | escape }}</span>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

    {% elsif service_kind == 'Conference Organization' %}
      {% assign organization_text = service_text | remove_first: 'Conference Organization:' | strip %}
      {% assign organization_roles = organization_text | split: ';' %}
      {% capture organization_years_text %}{%- for role_entry in organization_roles -%}{%- assign meetings_raw = role_entry | split: '(' | last | remove: ')' -%}{%- assign meetings = meetings_raw | split: ',' -%}{%- for meeting in meetings -%}{%- assign meeting_name = meeting | strip -%}{{- meeting_name | slice: -4, 4 -}}|{%- endfor -%}{%- endfor -%}{% endcapture %}
      {% assign organization_years = organization_years_text | split: '|' | uniq | sort | reverse %}
      <div class="academic-service-group">
        <h4 class="academic-service-group-title">Conference Organization</h4>
        {% for year in organization_years %}
          {% if year.size == 4 %}
            <div class="row academic-service-entry">
              <div class="col-sm-2 academic-service-date">
                <span class="badge font-weight-bold text-uppercase align-middle academic-service-year">{{ year | escape }}</span>
              </div>
              <div class="col-sm-10 academic-service-detail">
                {% for role_entry in organization_roles %}
                  {% assign organization_role = role_entry | split: '(' | first | strip %}
                  {% assign meetings_raw = role_entry | split: '(' | last | remove: ')' %}
                  {% assign meetings = meetings_raw | split: ',' %}
                  {% for meeting in meetings %}
                    {% assign meeting_name = meeting | strip %}
                    {% assign meeting_year = meeting_name | slice: -4, 4 %}
                    {% if meeting_year == year %}
                      {% assign meeting_short = meeting_name | remove: meeting_year | strip %}
                      <div class="academic-service-organizing-role">
                        <div class="title font-weight-bold ml-1 ml-md-4 academic-service-primary">{{ organization_role | escape }}</div>
                        <div class="institution font-weight-light ml-1 ml-md-4 academic-service-secondary">{{ meeting_short | escape }}</div>
                      </div>
                    {% endif %}
                  {% endfor %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

    {% else %}
      {% if service_text != '' %}
        <div class="academic-service-group academic-service-unknown">
          <div class="academic-service-detail">{{ entry.bullet | markdownify }}</div>
        </div>
      {% endif %}
    {% endif %}
  {% endfor %}
</section>
