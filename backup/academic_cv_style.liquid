{% comment %}
  Academic CV styling for al-folio v1.x / al_folio_cv.
  This file changes presentation only. CV data remain in _data/cv.yml.
  Compatible with both light and dark themes via al-folio CSS variables.
  Uses the official renderer's sibling structure:
  <a class="anchor" id="section-slug"></a><div class="card">...</div>
{% endcomment %}
<style>
/* --- Shared CV section design --- */
.cv {
  --academic-cv-accent: var(--global-theme-color, #87b8cb);
  --academic-cv-text: var(--global-text-color, #dce4ec);
  --academic-cv-bg: var(--global-bg-color, #111820);
  --academic-cv-border: color-mix(in srgb, var(--academic-cv-text) 16%, transparent);
  --academic-cv-surface: color-mix(in srgb, var(--academic-cv-bg) 88%, var(--academic-cv-text) 12%);
  --academic-cv-hover: color-mix(in srgb, var(--academic-cv-accent) 45%, transparent);
  width: 100%;
  min-width: 0;
}
.cv, .cv * { box-sizing: border-box; }

/* Outer section cards: same width, borders and heading treatment. */
.cv > .card,
.cv > a.anchor + .card {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-left: 0;
  margin-right: 0;
  padding: 1.2rem 1.3rem;
  background: transparent;
  border: 1px solid var(--academic-cv-border);
  border-radius: .85rem;
  box-shadow: none;
  color: var(--academic-cv-text);
}
.cv > .card > .card-title,
.cv > a.anchor + .card > .card-title {
  margin: 0 0 1.05rem;
  padding-bottom: .75rem;
  border-bottom: 1px solid var(--academic-cv-border);
  font-size: clamp(1.20rem, 2vw, 1.50rem);
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -.012em;
  color: var(--academic-cv-text);
}

/* The official RenderCV renderer uses one UL for each generic bullet. */
.cv > a.anchor:is(
  #academic-service,
  #honors-awards,
  #teaching-experience,
  #selected-publications,
  #selected-talks
) + .card > div > ul.list-group {
  list-style: none;
  padding: 0;
  margin: 0 0 .7rem;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.cv > a.anchor:is(
  #academic-service,
  #honors-awards,
  #teaching-experience,
  #selected-publications,
  #selected-talks
) + .card > div > ul.list-group:last-child { margin-bottom: 0; }

/* Academic Service: the same two-column card grid used by Activities. */
.cv > a#academic-service + .card > div {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}
.cv > a.anchor#academic-service + .card > div > ul.list-group {
  margin: 0;
  min-width: 0;
}
.cv > a#academic-service + .card > div > ul.list-group:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}

/* Academic Service / Teaching / Selected entries: understated inner cards. */
.cv > a.anchor:is(
  #academic-service,
  #teaching-experience,
  #selected-publications,
  #selected-talks
) + .card > div > ul.list-group > li.list-group-item,
.cv > a.anchor:is(
  #academic-service,
  #teaching-experience,
  #selected-publications,
  #selected-talks
) + .card > div > .card-text {
  display: block;
  margin: 0;
  padding: .9rem 1rem;
  border: 1px solid var(--academic-cv-border);
  border-radius: .7rem;
  background: var(--academic-cv-surface);
  color: var(--academic-cv-text);
  line-height: 1.65;
  white-space: normal;
  overflow-wrap: anywhere;
  transition: border-color .2s ease;
}
.cv > a.anchor:is(
  #academic-service,
  #teaching-experience,
  #selected-publications,
  #selected-talks
) + .card > div > ul.list-group > li.list-group-item:hover,
.cv > a.anchor:is(
  #academic-service,
  #teaching-experience,
  #selected-publications,
  #selected-talks
) + .card > div > .card-text:hover {
  border-color: var(--academic-cv-hover);
}
.cv > a.anchor:is(#academic-service, #teaching-experience) + .card > div > ul.list-group > li.list-group-item strong {
  display: block;
  margin-bottom: .20rem;
  color: var(--academic-cv-accent);
  font-weight: 650;
}

/* Honors & Awards: continuous, year-aligned rows as on Activities. */
.cv > a.anchor#honors-awards + .card > div > ul.list-group { margin: 0; }
.cv > a#honors-awards + .card > div > ul.list-group > li.list-group-item {
  display: grid;
  grid-template-columns: 4.5rem minmax(0, 1fr);
  align-items: baseline;
  gap: 1rem;
  padding: .9rem 1.1rem;
  margin: 0;
  background: var(--academic-cv-surface);
  border: 1px solid var(--academic-cv-border);
  border-bottom: 0;
  border-radius: 0;
  color: var(--academic-cv-text);
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.cv > a#honors-awards + .card > div > ul.list-group:first-child > li.list-group-item {
  border-radius: .75rem .75rem 0 0;
}
.cv > a#honors-awards + .card > div > ul.list-group:last-child > li.list-group-item {
  border-bottom: 1px solid var(--academic-cv-border);
  border-radius: 0 0 .75rem .75rem;
}
.cv > a#honors-awards + .card > div > ul.list-group > li.list-group-item strong {
  color: var(--academic-cv-accent);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* Generic label/details fields receive compatible row styling. */
.cv > a#honors-awards + .card > div > .card-text {
  padding: .9rem 1.1rem;
  border: 1px solid var(--academic-cv-border);
  border-bottom: 0;
  background: var(--academic-cv-surface);
  color: var(--academic-cv-text);
  line-height: 1.6;
}
.cv > a#honors-awards + .card > div > .card-text strong {
  color: var(--academic-cv-accent);
}

/* A clear, quiet link treatment for Selected Publications / Selected Talks. */
.cv > a.anchor:is(#selected-publications, #selected-talks) + .card a {
  color: var(--academic-cv-accent);
  text-underline-offset: .18rem;
  font-weight: 550;
}

/* Remove markdown-generated paragraph spacing inside cards. */
.cv > a.anchor:is(
  #academic-service,
  #honors-awards,
  #teaching-experience,
  #selected-publications,
  #selected-talks
) + .card .list-group-item p { margin: 0; }

@media (max-width: 680px) {
  .cv > a#academic-service + .card > div { grid-template-columns: 1fr; }
  .cv > a#academic-service + .card > div > ul.list-group:last-child:nth-child(odd) {
    grid-column: auto;
  }
  .cv > .card,
  .cv > a.anchor + .card { padding: .95rem; }
  .cv > a.anchor:is(
    #academic-service,
    #teaching-experience,
    #selected-publications,
    #selected-talks
  ) + .card > div > ul.list-group > li.list-group-item { padding: .8rem .85rem; }
  .cv > a#honors-awards + .card > div > ul.list-group > li.list-group-item {
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: .55rem;
    padding: .85rem;
  }
}
@media (prefers-reduced-motion: reduce) {
  .cv > a.anchor:is(
    #academic-service,
    #teaching-experience,
    #selected-publications,
    #selected-talks
  ) + .card > div > ul.list-group > li.list-group-item,
  .cv > a.anchor:is(
    #academic-service,
    #teaching-experience,
    #selected-publications,
    #selected-talks
  ) + .card > div > .card-text { transition: none; }
}
</style>
