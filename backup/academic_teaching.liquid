{% comment %}
  Reuses RenderCV-style Education fields for the Teaching Experience section.
  Entries come directly from _data/cv.yml; there is no second data source.
{% endcomment %}
{% assign teaching = include.entries %}
{% if teaching and teaching.size > 0 %}
<div class="academic-teaching-education" aria-label="Teaching experience entries">
  {% for entry in teaching %}
    {% if entry.institution or entry.company %}
    <div class="academic-teaching-entry">
      <div class="academic-teaching-dates">
        {% if entry.start_date %}{{ entry.start_date | escape }}{% endif %}{% if entry.start_date and entry.end_date %} &ndash; {% endif %}{% if entry.end_date %}{% assign finish = entry.end_date | replace: 'present', 'Present' %}{{ finish | escape }}{% endif %}
      </div>
      <div class="academic-teaching-info">
        {% assign role = entry.degree | default: entry.position %}
        {% if role %}<div class="academic-teaching-degree">{{ role | escape }}</div>{% endif %}
        {% assign school = entry.institution | default: entry.company %}
        {% if school %}<div class="academic-teaching-institution">{{ school | escape }}</div>{% endif %}
        {% if entry.area %}<div class="academic-teaching-area">{{ entry.area | escape }}</div>{% endif %}
        {% if entry.location %}<div class="academic-teaching-location">{{ entry.location | escape }}</div>{% endif %}
      </div>
    </div>
    {% endif %}
  {% endfor %}
</div>
{% endif %}
