/* Common CV design */
.cv {
  --academic-cv-accent: var(--global-theme-color, #87b8cb);
  --academic-cv-text: var(--global-text-color, #dce4ec);
  --academic-cv-bg: var(--global-bg-color, #111820);
  --academic-cv-border: color-mix(in srgb, var(--academic-cv-text) 16%, transparent);
  --academic-cv-surface: color-mix(in srgb, var(--academic-cv-bg) 88%, var(--academic-cv-text) 12%);
  --academic-cv-hover: color-mix(in srgb, var(--academic-cv-accent) 45%, transparent);
  width: 100%;
  max-width: 100%;
  min-width: 0;
}
.cv, .cv * { box-sizing: border-box; }

/* Keep all outer section cards intact, with consistent headings. */
.cv > .card,
.cv > a.anchor + .card {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-left: 0;
  margin-right: 0;
  padding: 1.2rem 1.3rem;
  background: transparent;
  border: 1px solid var(--academic-cv-border);
  border-radius: .85rem;
  box-shadow: none;
  color: var(--academic-cv-text);
}
.cv > .card > .card-title,
.cv > a.anchor + .card > .card-title {
  margin: 0 0 1.05rem;
  padding-bottom: .75rem;
  border-bottom: 1px solid var(--academic-cv-border);
  font-size: clamp(1.20rem, 2vw, 1.50rem);
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -.012em;
  color: var(--academic-cv-text);
}

/* Generic RenderCV bullet sections: one UL is generated per bullet. */
.cv > a.anchor:is(
  #academic-service,
  #honors-awards,
  #selected-publications,
  #selected-talks
) + .card > div > ul.list-group {
  list-style: none;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  min-width: 0;
}
.cv > a.anchor:is(
  #academic-service,
  #honors-awards,
  #selected-publications,
  #selected-talks
) + .card .list-group-item p { margin: 0; }

/* Academic Service: one full-width column, no nested cards. */
.cv > a#academic-service + .card > div {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
}
.cv > a#academic-service + .card > div > ul.list-group + ul.list-group {
  border-top: 1px solid var(--academic-cv-border);
}
.cv > a#academic-service + .card > div > ul.list-group > li.list-group-item,
.cv > a#academic-service + .card > div > .card-text {
  display: block;
  margin: 0;
  padding: .9rem 1rem;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  color: var(--academic-cv-text);
  line-height: 1.65;
  overflow-wrap: anywhere;
}
.cv > a#academic-service + .card > div > ul.list-group > li.list-group-item strong,
.cv > a#academic-service + .card > div > .card-text strong {
  display: block;
  margin-bottom: .20rem;
  color: var(--academic-cv-accent);
  font-weight: 650;
}

/* Awards: Education-like timeline without inner boxes.
   The renderer produces: <li><strong>2026:</strong> Award title...</li>
   Avoid CSS Grid on that <li>, because its text is not a wrapped element.
   Use a floated year in the left gutter; the remaining text occupies the
   full right-hand content column and wraps normally. */
.cv > a#honors-awards + .card > div > ul.list-group {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}
.cv > a#honors-awards + .card > div > ul.list-group + ul.list-group {
  border-top: 1px solid var(--academic-cv-border);
}
.cv > a#honors-awards + .card > div > ul.list-group > li.list-group-item,
.cv > a#honors-awards + .card > div > .card-text {
  display: flow-root;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: .85rem 1rem .85rem 8.35rem;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  color: var(--academic-cv-text);
  line-height: 1.6;
  white-space: normal;
  word-break: normal;
  overflow-wrap: break-word;
}
.cv > a#honors-awards + .card > div > ul.list-group > li.list-group-item > strong:first-child,
.cv > a#honors-awards + .card > div > .card-text > strong:first-child {
  float: left;
  display: inline-block;
  width: auto;
  max-width: 6.8rem;
  margin-left: -7.35rem;
  padding: .12rem .35rem;
  color: var(--academic-cv-accent);
  background: color-mix(in srgb, var(--academic-cv-accent) 15%, transparent);
  border-radius: .2rem;
  font-size: .85rem;
  font-weight: 650;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* Selected publications/talks: keep the established inner-card style. */
.cv > a.anchor:is(#selected-publications, #selected-talks) + .card > div > ul.list-group {
  margin-bottom: .7rem;
}
.cv > a.anchor:is(#selected-publications, #selected-talks) + .card > div > ul.list-group:last-child {
  margin-bottom: 0;
}
.cv > a.anchor:is(#selected-publications, #selected-talks) + .card > div > ul.list-group > li.list-group-item,
.cv > a.anchor:is(#selected-publications, #selected-talks) + .card > div > .card-text {
  display: block;
  margin: 0;
  padding: .9rem 1rem;
  border: 1px solid var(--academic-cv-border);
  border-radius: .7rem;
  background: var(--academic-cv-surface);
  color: var(--academic-cv-text);
  line-height: 1.65;
  white-space: normal;
  overflow-wrap: anywhere;
  transition: border-color .2s ease;
}
.cv > a.anchor:is(#selected-publications, #selected-talks) + .card > div > ul.list-group > li.list-group-item:hover,
.cv > a.anchor:is(#selected-publications, #selected-talks) + .card > div > .card-text:hover {
  border-color: var(--academic-cv-hover);
}
.cv > a.anchor:is(#selected-publications, #selected-talks) + .card a {
  color: var(--academic-cv-accent);
  text-underline-offset: .18rem;
  font-weight: 550;
}

/* Teaching Experience: reuse the official Education include,
   keep its normal padding and strip *only* nested borders/backgrounds. */
.cv > a.anchor#lectures + .card > div:not(.academic-teaching-education) {
  display: none;
}
.cv > a.anchor#lectures + .card > .academic-teaching-education {
  width: 100%;
  max-width: 100%;
  background: transparent;
  border: 0;
  box-shadow: none;
}
.cv > a.anchor#lectures + .card .academic-teaching-education :is(
  .row,
  .card,
  .card-body,
  .card-text,
  .list-group,
  .list-group-item,
  .academic-teaching-entry
) {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}

/* Keep the older custom teaching-entry selectors harmless if present. */
.cv .academic-teaching-entry {
  display: grid;
  grid-template-columns: minmax(7rem, 20%) minmax(0, 1fr);
  align-items: start;
  column-gap: 1.35rem;
  row-gap: .35rem;
  padding: .85rem 0;
  border-bottom: 1px solid var(--academic-cv-border);
}
.cv .academic-teaching-entry:first-child { padding-top: .25rem; }
.cv .academic-teaching-entry:last-child { border-bottom: 0; padding-bottom: .2rem; }
.cv .academic-teaching-dates {
  color: var(--academic-cv-accent);
  font-size: .90rem;
  font-variant-numeric: tabular-nums;
  line-height: 1.6;
}
.cv .academic-teaching-info { min-width: 0; line-height: 1.55; }
.cv .academic-teaching-degree { color: var(--academic-cv-text); font-weight: 650; font-size: 1rem; }
.cv .academic-teaching-institution { font-weight: 550; margin-top: .12rem; }
.cv .academic-teaching-area,
.cv .academic-teaching-location { opacity: .78; font-size: .91rem; margin-top: .12rem; }

@media (max-width: 680px) {
  .cv > .card,
  .cv > a.anchor + .card { padding: .95rem; }
  .cv > a#honors-awards + .card > div > ul.list-group > li.list-group-item,
  .cv > a#honors-awards + .card > div > .card-text {
    padding: .8rem .55rem .8rem 6.05rem;
  }
  .cv > a#honors-awards + .card > div > ul.list-group > li.list-group-item > strong:first-child,
  .cv > a#honors-awards + .card > div > .card-text > strong:first-child {
    margin-left: -5.5rem;
  }
  .cv > a#academic-service + .card > div > ul.list-group > li.list-group-item,
  .cv > a#academic-service + .card > div > .card-text { padding: .8rem .55rem; }
  .cv .academic-teaching-entry { grid-template-columns: 1fr; row-gap: .25rem; }
}
@media (prefers-reduced-motion: reduce) {
  .cv > a.anchor:is(#selected-publications, #selected-talks) + .card > div > ul.list-group > li.list-group-item,
  .cv > a.anchor:is(#selected-publications, #selected-talks) + .card > div > .card-text { transition: none; }
}
