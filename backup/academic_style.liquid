<style>
/* Scoped enhancement for the Publications and Activities pages.
   Uses al-folio theme colors, including dark/light mode. */
.academic-content {
  --academic-line: color-mix(in srgb, var(--global-text-color, #d4dce3) 16%, transparent);
  --academic-surface: color-mix(in srgb, var(--global-bg-color, #111820) 88%, var(--global-text-color, #ecf0f4) 12%);
  --academic-accent: var(--global-theme-color, #87b8cb);
  color: var(--global-text-color, inherit);
}
.academic-content .academic-lead {
  margin: 0 0 2rem;
  max-width: 44rem;
  opacity: .76;
  line-height: 1.75;
}
.academic-content .academic-section { margin: 0 0 3.25rem; }
.academic-content .academic-section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: .75rem;
  padding-bottom: .85rem;
  margin-bottom: 1.15rem;
  border-bottom: 1px solid var(--academic-line);
}
.academic-content .academic-eyebrow {
  margin: 0 0 .4rem;
  color: var(--academic-accent);
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .1em;
  line-height: 1.4;
}
.academic-content .academic-section-heading h2 {
  margin: 0;
  font-size: clamp(1.25rem, 2.2vw, 1.6rem);
  font-weight: 600;
  letter-spacing: -.015em;
  line-height: 1.35;
}
.academic-content .academic-count {
  flex-shrink: 0;
  border: 1px solid var(--academic-line);
  border-radius: 99px;
  padding: .25rem .6rem;
  font-size: .74rem;
  opacity: .76;
}
/* Publication cards: keep the core al-folio bibliography renderer. */
.academic-publications .academic-bibliography .bibliography {
  margin: 0;
  padding: 0;
  list-style: none;
}
.academic-publications .academic-bibliography .bibliography > li {
  list-style: none;
  margin: 0 0 .85rem;
  padding: 1rem 1.15rem;
  border: 1px solid var(--academic-line);
  border-radius: .8rem;
  background: var(--academic-surface);
  transition: border-color .2s ease;
}
.academic-publications .academic-bibliography .bibliography > li:hover {
  border-color: color-mix(in srgb, var(--academic-accent) 55%, transparent);
}
.academic-publications .academic-bibliography h2,
.academic-publications .academic-bibliography h3 {
  margin: 1.2rem 0 .7rem;
  font-size: 1rem;
  font-weight: 600;
  color: var(--academic-accent);
}
.academic-publications .academic-bibliography .title {
  font-weight: 600;
  line-height: 1.5;
}
/* Service cards and award timeline. */
.academic-content .academic-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}
.academic-content .academic-grid > :last-child { grid-column: 1 / -1; }
.academic-content .academic-card {
  background: var(--academic-surface);
  border: 1px solid var(--academic-line);
  border-radius: .85rem;
  padding: 1.2rem;
  min-width: 0;
}
.academic-content .academic-card h3 {
  margin: 0 0 1rem;
  font-size: 1.1rem;
  font-weight: 600;
}
.academic-content .academic-card-title {
  margin: 0 0 .4rem;
  font-weight: 600;
  line-height: 1.6;
}
.academic-content .academic-muted { font-size: .9rem; opacity: .75; }
.academic-content .academic-tag-list,
.academic-content .academic-simple-list,
.academic-content .academic-role-list,
.academic-content .academic-awards { list-style: none; margin: 0; padding: 0; }
.academic-content .academic-tag-list { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .8rem; }
.academic-content .academic-tag-list li {
  border: 1px solid var(--academic-line);
  border-radius: 99px;
  padding: .2rem .55rem;
  font-size: .76rem;
}
.academic-content .academic-simple-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .5rem; }
.academic-content .academic-simple-list li { padding-bottom: .35rem; border-bottom: 1px solid var(--academic-line); }
.academic-content .academic-role-list li {
  padding: .55rem 0;
  border-bottom: 1px solid var(--academic-line);
  display: flex;
  flex-direction: column;
  gap: .2rem;
}
.academic-content .academic-role-list li:last-child { border-bottom: 0; }
.academic-content .academic-role-list strong { font-size: .9rem; font-weight: 600; }
.academic-content .academic-role-list span { opacity: .75; }
.academic-content .academic-awards li {
  display: grid;
  grid-template-columns: 4.5rem minmax(0,1fr);
  align-items: baseline;
  gap: 1rem;
  padding: .9rem 1.1rem;
  background: var(--academic-surface);
  border: 1px solid var(--academic-line);
  border-bottom: none;
  line-height: 1.6;
}
.academic-content .academic-awards li:first-child { border-radius: .75rem .75rem 0 0; }
.academic-content .academic-awards li:last-child { border-bottom: 1px solid var(--academic-line); border-radius: 0 0 .75rem .75rem; }
.academic-content .academic-year { color: var(--academic-accent); font-weight: 700; font-variant-numeric: tabular-nums; }
@media (max-width: 680px) {
  .academic-content .academic-grid { grid-template-columns: 1fr; }
  .academic-content .academic-grid > :last-child { grid-column: auto; }
  .academic-content .academic-section-heading { align-items: start; flex-direction: column; }
  .academic-content .academic-awards li { grid-template-columns: 3.5rem minmax(0,1fr); gap: .55rem; padding: .85rem; }
  .academic-publications .academic-bibliography .bibliography > li { padding: .85rem; }
}
</style>

<style>
/* 2026 unified extension: shared width, Home news cards and Talks. */
:root { --academic-max-width: var(--max-content-width, 930px); }
/* Avoid nested page-specific max widths; the al-folio shell controls width. */
.academic-content { width: 100%; max-width: 100%; min-width: 0; margin-inline: 0; box-sizing: border-box; }
.academic-content * { box-sizing: border-box; }
.academic-home .academic-section { margin-bottom: 2.3rem; }
.academic-home .academic-section-heading { margin-top: .4rem; }
.academic-home .academic-section-heading h2 { font-size: clamp(1.2rem, 2.2vw, 1.55rem); }
.academic-home .academic-prose { line-height: 1.75; }
.academic-home .academic-prose p:last-child { margin-bottom: 0; }
.academic-home .academic-interests { display: flex; flex-wrap: wrap; gap: .55rem; list-style: none; padding-left: 0; }
.academic-home .academic-interests li { padding: .55rem .85rem; border-radius: .65rem; background: var(--academic-surface); border: 1px solid var(--academic-line); }
.academic-news-list { display: grid; grid-template-columns: 1fr; gap: .75rem; }
.academic-news-card { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1.1rem; align-items: start; padding: 1rem 1.15rem; background: var(--academic-surface); border: 1px solid var(--academic-line); border-radius: .85rem; }
.academic-news-date { color: var(--academic-accent); font-size: .79rem; letter-spacing: .02em; font-weight: 650; white-space: nowrap; margin-top: .12rem; }
.academic-news-text { min-width: 0; font-size: .93rem; line-height: 1.6; }
.academic-news-text p { margin: 0 0 .4rem; }
.academic-news-text p:last-child { margin: 0; }
.academic-inline-link, .academic-talk-links a { color: var(--academic-accent); font-weight: 600; text-decoration: none; }
.academic-news-card:hover, .academic-talk-card:hover { border-color: color-mix(in srgb, var(--academic-accent) 55%, transparent); }
.academic-talk-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
.academic-talk-card h3 { margin: .2rem 0 .8rem; line-height: 1.45; }
.academic-talk-card .academic-card-title { margin-bottom: .35rem; }
.academic-talk-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; font-size: .84rem; }
/* Headings in page bodies follow the same left edge as the CV header. */
.academic-content .academic-lead, .academic-content .academic-section-heading { width: 100%; max-width: none; }
@media (max-width: 720px) {
  .academic-talk-grid { grid-template-columns: 1fr; }
  .academic-news-card { grid-template-columns: 1fr; gap: .35rem; padding: .85rem; }
}
</style>
